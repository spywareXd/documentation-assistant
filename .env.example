# Copy to .env and fill in. Never commit .env.

# Generation, query rewriting, grading, judging (Groq, GPT-OSS models)
GROQ_API_KEY=

# Local vector DB (docker compose up -d qdrant)
QDRANT_URL=http://localhost:6333

# Optional: GitHub token raises the rate limit when downloading doc sources
GITHUB_TOKEN=

# Optional: LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=documentation-assistant

# Frozen baseline only (experiment E0)
GOOGLE_API_KEY=
PINECONE_API_KEY=
INDEX_NAME=document-assistant
TAVILY_API_KEY=
